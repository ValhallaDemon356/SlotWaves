APP_NAME=SlotWaves
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database Configuration ──────────────────────────────────────────────────
# Supabase PostgreSQL — Transaction Pooler (port 6543, for serverless/Vercel)
# Use Session Pooler (port 5432) only for long-lived server environments.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.[YOUR_PROJECT_REF]
DB_PASSWORD=
DB_SSLMODE=require
DB_SCHEMA=public

# ── Session ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# MUST be true for production HTTPS (Vercel) — prevents 419 CSRF errors
SESSION_SECURE_COOKIE=false

# ── Filesystem & Queue ───────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# ── Cache ────────────────────────────────────────────────────────────────────
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@slotwaves.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS / S3 ─────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Vite / Frontend ──────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Vercel / Serverless Path Overrides ───────────────────────────────────────
# These are set automatically by vercel.json env block — do not set manually.
# APP_STORAGE_PATH=/tmp/storage
# VIEW_COMPILED_PATH=/tmp/storage/framework/views
# APP_CONFIG_CACHE=/tmp/config.php
# APP_EVENTS_CACHE=/tmp/events.php
# APP_PACKAGES_CACHE=/tmp/packages.php
# APP_ROUTES_CACHE=/tmp/routes.php
# APP_SERVICES_CACHE=/tmp/services.php

# ════════════════════════════════════════════════════════════════════════════
# VERCEL DASHBOARD — Required Environment Variables
# Set these in: Vercel Project → Settings → Environment Variables
# ════════════════════════════════════════════════════════════════════════════
#
# APP_KEY            = base64:<your-app-key>
# APP_URL            = https://slot-waves.vercel.app
# APP_NAME           = SlotWaves
# DB_CONNECTION      = pgsql
# DB_HOST            = aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT            = 6543
# DB_DATABASE        = postgres
# DB_USERNAME        = postgres.<your-project-ref>
# DB_PASSWORD        = <your-supabase-password>
# DB_SSLMODE         = require
# SESSION_DRIVER     = database
# SESSION_SECURE_COOKIE = true
# CACHE_STORE        = database
# QUEUE_CONNECTION   = sync
# FILESYSTEM_DISK    = local
#
# These are set automatically by vercel.json env block:
# APP_ENV            = production
# APP_DEBUG          = false
# LOG_CHANNEL        = stderr
# SESSION_SECURE_COOKIE = true
# SESSION_DRIVER     = database
# CACHE_STORE        = database
# ════════════════════════════════════════════════════════════════════════════
